set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
if(NOT DEFINED ENV{VOZ_MINGW_ROOT})
    message(FATAL_ERROR "Defina VOZ_MINGW_ROOT para o LLVM-MinGW verificado.")
endif()
set(VOZ_MINGW "$ENV{VOZ_MINGW_ROOT}/bin")
set(CMAKE_C_COMPILER "${VOZ_MINGW}/x86_64-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${VOZ_MINGW}/x86_64-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${VOZ_MINGW}/x86_64-w64-mingw32-windres")
set(CMAKE_AR "${VOZ_MINGW}/llvm-ar")
set(CMAKE_RANLIB "${VOZ_MINGW}/llvm-ranlib")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
# Upstream examples/common.cpp relies on a transitive <algorithm> include in libstdc++.
# libc++ correctly requires it explicitly; keep the verified vendor sources unchanged.
set(CMAKE_CXX_FLAGS_INIT "-include algorithm")
set(CMAKE_FIND_ROOT_PATH "$ENV{VOZ_MINGW_ROOT}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
